# Application Settings
APP_NAME=Jedwal API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API Configuration
ALLOWED_ORIGINS=["*"]

# AWS Configuration
AWS_REGION=us-east-1
# Note: In Lambda, credentials are provided via IAM execution role
# DYNAMODB_ENDPOINT_URL is only for local development with DynamoDB Local
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# DynamoDB Tables
SHEETS_API_TABLE=jedwal_sheets_api

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_SECRET_TOKEN=your-oauth-secret-token

# Sentry
SENTRY_DSN=your-sentry-dsn

# Stripe
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_SUBSCRIPTION_PRICE_ID=your-stripe-subscription-price-id
STRIPE_USAGE_BASED_PRICE_ID=your-stripe-usage-based-price-id
STRIPE_SECRET_KEY=your-stripe-secret-key

# URLs
API_BASE_URL=http://localhost:8000
CLIENT_BASE_URL=http://localhost:3000
CLIENT_APP_BASE_URL=http://localhost:3001

# Cookies
COOKIE_ALLOWED_DOMAIN=localhost

# CloudFront
CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-distribution-id

# Encryption
ENCRYPTION_KEY_ID=your-encryption-key-id

# Email
EMAILS_ENABLED=true

# Free tier limits
FREE_TIER_REQUEST_LIMIT=5000

# Testing
TEST_DATA_REFRESH_INFO=

# Webhooks & Queues
WEBHOOK_QUEUE_URL=your-webhook-queue-url

# Image Storage
IMAGE_STORAGE_BUCKET=your-image-storage-bucket
IMAGE_STORAGE_BUCKET_URL=https://your-bucket.s3.amazonaws.com
